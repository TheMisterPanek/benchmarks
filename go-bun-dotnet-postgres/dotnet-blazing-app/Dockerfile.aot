ARG DOTNET_CHANNEL=10.0
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_CHANNEL} AS build
ARG DOTNET_CHANNEL=10.0
ENV TargetFramework=net${DOTNET_CHANNEL}
WORKDIR /src

RUN apt-get update && apt-get install -y --no-install-recommends clang zlib1g-dev && rm -rf /var/lib/apt/lists/*

COPY DotnetBlazingApp.csproj ./
RUN dotnet restore -r linux-x64 -p:PublishAot=true

COPY Program.cs ./
RUN dotnet publish -c Release -r linux-x64 -p:PublishAot=true -o /app --no-restore

FROM mcr.microsoft.com/dotnet/runtime-deps:${DOTNET_CHANNEL}
WORKDIR /app
COPY --from=build /app/DotnetBlazingApp ./

EXPOSE 8080
ENTRYPOINT ["./DotnetBlazingApp"]
